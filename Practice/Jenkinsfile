pipeline {
    agent any

    triggers {
        githubPush()
    }

    options {
        skipStagesAfterUnstable()
    }

    environment {
        JUNIT_JAR_URL = 'https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/1.7.1/junit-platform-console-standalone-1.7.1.jar'
        JUNIT_JAR_PATH = 'lib/junit.jar'
        SOURCE_DIR = 'Practice/student'
        CLASS_DIR = 'classes'
        REPORT_DIR = 'test-reports'
        BUILD_LOG = 'build.log'
        ANALYSIS_FILE = 'failure-analysis.txt'
        SUCCESS_LOG_FILE = 'build-success.txt'
        NOTIFY_EMAIL = 'gymclass@g.hongik.ac.kr'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare') {
            steps {
                sh '''
                    mkdir -p ${CLASS_DIR}
                    mkdir -p ${REPORT_DIR}
                    mkdir -p lib
                    chmod +x Practice/scripts/analyze_failure.sh
                    echo "[+] Downloading JUnit JAR..."
                    curl -L -o ${JUNIT_JAR_PATH} ${JUNIT_JAR_URL}
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "[+] Compiling student Java files..."
                    find ${SOURCE_DIR} -name "*.java" > sources.txt
                    set +e
                    javac -encoding UTF-8 -d ${CLASS_DIR} -cp ${JUNIT_JAR_PATH} @sources.txt > ${BUILD_LOG} 2>&1
                    status=$?
                    set -e
                    cat ${BUILD_LOG}
                    exit ${status}
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "[+] Running StudentManager tests with JUnit..."
                    set +e
                    java -jar ${JUNIT_JAR_PATH} \
                        --class-path ${CLASS_DIR} \
                        --scan-class-path \
                        --details=tree \
                        --details-theme=ascii \
                        --reports-dir ${REPORT_DIR} \
                        --config=junit.platform.output.capture.stdout=true \
                        --config=junit.platform.reporting.open.xml.enabled=true \
                        > ${REPORT_DIR}/test-output.txt 2>&1
                    status=$?
                    set -e
                    cat ${REPORT_DIR}/test-output.txt
                    exit ${status}
                '''
            }
        }
    }

    post {
        always {
            echo '[*] Archiving test results and logs...'
            junit testResults: "${REPORT_DIR}/**/*.xml", allowEmptyResults: true
            archiveArtifacts artifacts: "${REPORT_DIR}/**/*, ${BUILD_LOG}", allowEmptyArchive: true
        }

        failure {
            echo '[!] Build or test failed. Running failure analyzer...'
            sh './Practice/scripts/analyze_failure.sh || true'
            archiveArtifacts artifacts: "${ANALYSIS_FILE}", allowEmptyArchive: true
            script {
                try {
                    mail to: env.NOTIFY_EMAIL,
                         subject: "Jenkins Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                         body: """StudentManager Java project build or test failed.

Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Workspace: ${env.WORKSPACE}
Failure analysis file: ${env.ANALYSIS_FILE}

Open the archived failure-analysis.txt artifact in Jenkins to see the detected cause and suggested fixes.
"""
                } catch (err) {
                    echo "Email notification failed. Configure Jenkins SMTP settings to send mail: ${err}"
                }
            }
        }

        success {
            writeFile file: env.SUCCESS_LOG_FILE, text: """Build and test succeeded
Project: StudentManager
Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Workspace: ${env.WORKSPACE}
Result: SUCCESS
"""
            archiveArtifacts artifacts: "${SUCCESS_LOG_FILE}", allowEmptyArchive: false
            echo 'Build and test succeeded'
            script {
                try {
                    mail to: env.NOTIFY_EMAIL,
                         subject: "Jenkins Build Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                         body: """StudentManager Java project build and test completed successfully.

Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Workspace: ${env.WORKSPACE}
Success log file: ${env.SUCCESS_LOG_FILE}
"""
                } catch (err) {
                    echo "Email notification failed. Configure Jenkins SMTP settings to send mail: ${err}"
                }
            }
        }
    }
}